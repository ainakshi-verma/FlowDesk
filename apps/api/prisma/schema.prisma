generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String
  name         String
  avatarUrl    String?
  targetRole   String?            @default("Full Stack Developer")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  workspaces   Workspace[]
  tasks        Task[]
  documents    Document[]
  applications JobApplication[]
  interviews   InterviewSession[]
  skills       UserSkill[]
}

model Workspace {
  id           String             @id @default(uuid())
  userId       String
  name         String
  description  String?
  color        String?            @default("#0ea5e9")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks        Task[]
  documents    Document[]
  applications JobApplication[]
  interviews   InterviewSession[]
}

model Task {
  id           String    @id @default(uuid())
  workspaceId  String
  userId       String
  title        String
  description  String?
  status       String    @default("TODO") // TODO, IN_PROGRESS, REVIEW, COMPLETED
  priority     String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  estimatedMin Int?      @default(45)
  dueDate      DateTime?
  scheduledAt  DateTime?
  tags         String?   @default("[]") // JSON string array of tags e.g. ["DSA", "React"]
  sourceType   String?   @default("MANUAL") // MANUAL, MOCK_INTERVIEW, AI_PLANNER, SKILL_GAP
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Document {
  id          String          @id @default(uuid())
  workspaceId String
  userId      String
  title       String
  docType     String          // RESUME, JOB_DESCRIPTION, NOTE, INTERVIEW_EXP, SYLLABUS
  rawText     String
  fileUrl     String?
  fileSize    Int?
  metadata    String?         // JSON string with parsed skills, experience, company, requirements
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks      DocumentChunk[]
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  content    String
  chunkIndex Int
  embedding  String?  // JSON string array of floats for vector search
  createdAt  DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model JobApplication {
  id                 String    @id @default(uuid())
  workspaceId        String
  userId             String
  company            String
  role               String
  jobUrl             String?
  jobDescriptionText String?
  status             String    @default("WISHLIST") // WISHLIST, APPLIED, OA, TECHNICAL, HR, OFFER, REJECTED
  appliedDate        DateTime?
  interviewDate      DateTime?
  matchScore         Int?      @default(0) // 0-100% computed by Career Agent
  analysis           String?   // JSON string with matching skills, missing skills, advice
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewSession {
  id              String              @id @default(uuid())
  workspaceId     String
  userId          String
  title           String
  roleType        String              // FRONTEND, BACKEND, FULLSTACK, SYSTEM_DESIGN, HR
  status          String              @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ABANDONED
  overallScore    Int?
  scores          String?             // JSON string: { technical: 80, communication: 75, problemSolving: 85, confidence: 70 }
  feedbackSummary String?
  weakAreas       String?             // JSON string array of extracted weak topics
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchanges       InterviewExchange[]
}

model InterviewExchange {
  id          String           @id @default(uuid())
  interviewId String
  turnOrder   Int
  speaker     String           // INTERVIEWER | CANDIDATE
  message     String
  critique    String?
  score       Int?
  createdAt   DateTime         @default(now())

  interview   InterviewSession @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

model UserSkill {
  id        String   @id @default(uuid())
  userId    String
  name      String
  category  String   // LANGUAGE, FRAMEWORK, DATABASE, TOOL, CONCEPT
  level     String   @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  verified  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
